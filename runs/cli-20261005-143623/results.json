  {
   "id": "r7",
   "tool": "query_metric",
   "args": {
    "metrics": [
     "revenue",
     "accounts_payable",
     "cash",
     "cogs",
     "dio",
     "dso",
     "dpo",
     "ccc"
    ],
    "companies": [
     "Lenovo"
    ],
    "period_from": "FY22Q3",
    "period_to": "FY23Q3",
    "last_n": null,
    "period_basis": "fiscal",
    "group_by": [],
    "filters": {}
   },
   "sql": "SELECT t.company, t.fiscal_year, t.fiscal_quarter, t.calendar_quarter, t.days,\n       t.revenue AS revenue,\n       t.accounts_payable AS accounts_payable,\n       t.cash AS cash,\n       t.cogs AS cogs,\n       (CASE WHEN t.cogs <> 0 THEN (t.inventory + t.inventory_prev) / 2.0 / t.cogs * t.days END) AS dio,\n       (CASE WHEN t.revenue <> 0 THEN (t.accounts_receivable + t.accounts_receivable_prev) / 2.0 / t.revenue * t.days END) AS dso,\n       (CASE WHEN t.cogs <> 0 THEN (t.accounts_payable + t.accounts_payable_prev) / 2.0 / t.cogs * t.days END) AS dpo,\n       ((CASE WHEN t.cogs <> 0 THEN (t.inventory + t.inventory_prev) / 2.0 / t.cogs * t.days END) + (CASE WHEN t.revenue <> 0 THEN (t.accounts_receivable + t.accounts_receivable_prev) / 2.0 / t.revenue * t.days END) - (CASE WHEN t.cogs <> 0 THEN (t.accounts_payable + t.accounts_payable_prev) / 2.0 / t.cogs * t.days END)) AS ccc\nFROM (SELECT t2.*,\n       LAG(t2.inventory) OVER w AS inventory_prev,\n       LAG(t2.accounts_receivable) OVER w AS accounts_receivable_prev,\n       LAG(t2.accounts_payable) OVER w AS accounts_payable_prev\nFROM (SELECT p.company_id AS company, p.fiscal_year, p.fiscal_quarter, p.calendar_quarter, p.days,\n       MAX(CASE WHEN f.account_code = 'accounts_payable' THEN f.value END) AS accounts_payable,\n       MAX(CASE WHEN f.account_code = 'accounts_receivable' THEN f.value END) AS accounts_receivable,\n       MAX(CASE WHEN f.account_code = 'cash' THEN f.value END) AS cash,\n       MAX(CASE WHEN f.account_code = 'cogs' THEN f.value END) AS cogs,\n       MAX(CASE WHEN f.account_code = 'inventory' THEN f.value END) AS inventory,\n       MAX(CASE WHEN f.account_code = 'revenue' THEN f.value END) AS revenue\nFROM facts f\nJOIN periods p USING (company_id, fiscal_year, fiscal_quarter)\nWHERE f.version = 'original' AND p.company_id IN ('Lenovo') AND (p.fiscal_year < 2023 OR (p.fiscal_year = 2023 AND p.fiscal_quarter <= 3))\nGROUP BY 1, 2, 3, 4, 5) t2\nWINDOW w AS (PARTITION BY t2.company ORDER BY t2.fiscal_year, t2.fiscal_quarter)) t\nWHERE (t.fiscal_year > 2022 OR (t.fiscal_year = 2022 AND t.fiscal_quarter >= 3))\nORDER BY t.company, t.fiscal_year, t.fiscal_quarter",
