  {
   "id": "r3",
   "tool": "query_metric",
   "args": {
    "metrics": [
     "inventory",
     "revenue",
     "cogs",
     "dio"
    ],
    "companies": [
     "Lenovo"
    ],
    "period_from": "FY23Q3",
    "period_to": "FY24Q3",
    "last_n": null,
    "period_basis": "fiscal",
    "group_by": [],
    "filters": {}
   },
   "sql": "SELECT t.company, t.fiscal_year, t.fiscal_quarter, t.calendar_quarter, t.days,\n       t.inventory AS inventory,\n       t.revenue AS revenue,\n       t.cogs AS cogs,\n       (CASE WHEN t.cogs <> 0 THEN (t.inventory + t.inventory_prev) / 2.0 / t.cogs * t.days END) AS dio\nFROM (SELECT t2.*,\n       LAG(t2.inventory) OVER w AS inventory_prev\nFROM (SELECT p.company_id AS company, p.fiscal_year, p.fiscal_quarter, p.calendar_quarter, p.days,\n       MAX(CASE WHEN f.account_code = 'cogs' THEN f.value END) AS cogs,\n       MAX(CASE WHEN f.account_code = 'inventory' THEN f.value END) AS inventory,\n       MAX(CASE WHEN f.account_code = 'revenue' THEN f.value END) AS revenue\nFROM facts f\nJOIN periods p USING (company_id, fiscal_year, fiscal_quarter)\nWHERE f.version = 'original' AND p.company_id IN ('Lenovo') AND (p.fiscal_year < 2024 OR (p.fiscal_year = 2024 AND p.fiscal_quarter <= 3))\nGROUP BY 1, 2, 3, 4, 5) t2\nWINDOW w AS (PARTITION BY t2.company ORDER BY t2.fiscal_year, t2.fiscal_quarter)) t\nWHERE (t.fiscal_year > 2023 OR (t.fiscal_year = 2023 AND t.fiscal_quarter >= 3))\nORDER BY t.company, t.fiscal_year, t.fiscal_quarter",
   "unit": "",
