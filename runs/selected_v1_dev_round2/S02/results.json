  {
   "id": "r3",
   "tool": "query_metric",
   "args": {
    "metrics": [
     "revenue",
     "cogs",
     "gross_profit",
     "gross_margin",
     "operating_income"
    ],
    "companies": [
     "Lenovo"
    ],
    "period_from": "FY25Q1",
    "period_to": "FY26Q4",
    "last_n": null,
    "period_basis": "fiscal",
    "group_by": [],
    "filters": {}
   },
   "sql": "SELECT t.company, t.fiscal_year, t.fiscal_quarter, t.calendar_quarter, t.days,\n       t.revenue AS revenue,\n       t.cogs AS cogs,\n       t.gross_profit AS gross_profit,\n       (t.gross_profit / NULLIF(t.revenue, 0)) AS gross_margin,\n       t.operating_income AS operating_income\nFROM (SELECT p.company_id AS company, p.fiscal_year, p.fiscal_quarter, p.calendar_quarter, p.days,\n       MAX(CASE WHEN f.account_code = 'cogs' THEN f.value END) AS cogs,\n       MAX(CASE WHEN f.account_code = 'gross_profit' THEN f.value END) AS gross_profit,\n       MAX(CASE WHEN f.account_code = 'operating_income' THEN f.value END) AS operating_income,\n       MAX(CASE WHEN f.account_code = 'revenue' THEN f.value END) AS revenue\nFROM facts f\nJOIN periods p USING (company_id, fiscal_year, fiscal_quarter)\nWHERE f.version = 'original' AND p.company_id IN ('Lenovo') AND (p.fiscal_year > 2025 OR (p.fiscal_year = 2025 AND p.fiscal_quarter >= 1)) AND (p.fiscal_year < 2026 OR (p.fiscal_year = 2026 AND p.fiscal_quarter <= 4))\nGROUP BY 1, 2, 3, 4, 5) t\nORDER BY t.company, t.fiscal_year, t.fiscal_quarter",
   "unit": "",
