  {
   "id": "r3",
   "tool": "query_metric",
   "args": {
    "metrics": [
     "revenue",
     "cogs",
     "gross_profit",
     "operating_income",
     "net_income",
     "gross_margin"
    ],
    "companies": [
     "Lenovo",
     "HP",
     "Dell"
    ],
    "period_from": "FY23Q3",
    "period_to": "FY25Q2",
    "last_n": null,
    "period_basis": "fiscal",
    "group_by": [],
    "filters": {}
   },
   "sql": "SELECT t.company, t.fiscal_year, t.fiscal_quarter, t.calendar_quarter, t.days,\n       t.revenue AS revenue,\n       t.cogs AS cogs,\n       t.gross_profit AS gross_profit,\n       t.operating_income AS operating_income,\n       t.net_income AS net_income,\n       (t.gross_profit / NULLIF(t.revenue, 0)) AS gross_margin\nFROM (SELECT p.company_id AS company, p.fiscal_year, p.fiscal_quarter, p.calendar_quarter, p.days,\n       MAX(CASE WHEN f.account_code = 'cogs' THEN f.value END) AS cogs,\n       MAX(CASE WHEN f.account_code = 'gross_profit' THEN f.value END) AS gross_profit,\n       MAX(CASE WHEN f.account_code = 'net_income' THEN f.value END) AS net_income,\n       MAX(CASE WHEN f.account_code = 'operating_income' THEN f.value END) AS operating_income,\n       MAX(CASE WHEN f.account_code = 'revenue' THEN f.value END) AS revenue\nFROM facts f\nJOIN periods p USING (company_id, fiscal_year, fiscal_quarter)\nWHERE f.version = 'original' AND p.company_id IN ('Lenovo', 'HP', 'Dell') AND (p.fiscal_year > 2023 OR (p.fiscal_year = 2023 AND p.fiscal_quarter >= 3)) AND (p.fiscal_year < 2025 OR (p.fiscal_year = 2025 AND p.fiscal_quarter <= 2))\nGROUP BY 1, 2, 3, 4, 5) t\nORDER BY t.company, t.fiscal_year, t.fiscal_quarter",
   "unit": "",
