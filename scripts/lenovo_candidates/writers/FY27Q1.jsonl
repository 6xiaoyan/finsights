st_include": ["分部收入合计必须减抵销 1556.5 才等于集团收入；直接相加高估 5.8%", "各分部收入金额贡献：ISG 最大（+4219.9），其后 IDG（+3646.2）、SSG（+625.9），抵销为负贡献 -379.1，四项加总勾稽 +8112.9", "经营溢利上 SSG 增速(+39.1%)高于 IDG(+27.3%)但金额贡献更小(196.0 vs 259.6)——增速排序不等于金额排序，基数与符号都影响", "ISG 由 -85.5 转 +776.9 是同比改善的最大单项，但'转盈'不能表述为增速（除零/符号变化不可比）", "两级勾稽：2082.153 经未分配项（含认股权证 -1690.3）桥接到除税前 -179.921"], "acceptable_variants": ["贡献占比用占集团变化或占正向贡献合计等不同分母，只要口径声明清楚", "把抵销并入任一分部的替代分解，需明确说明"], "must_not_claim": ["不得把分部经营溢利口径当作集团呈报经营溢利或税前利润", "不得由分部数字断言各分部增长的需求/价格原因（无销量与价格数据）"], "unknowns": ["分部增长的经营性驱动（AI 服务器需求等）在数字上不可辨识，公告叙述属管理层判断"]}, "db_support": {"status": "needs_numeric_data", "checked_at": "2026-10-05", "missing_fields": ["segment_revenue", "segment_operating_profit", "unallocated_items", "intersegment_elimination"], "notes": "仅集团收入/经营溢利可查 DB；真实分部表在 PDF p7，未入统一数据层（既有证据文件 docs/evidence/attribution_case/lenovo_real_segments.csv 亦仅 FY23 期间，需用户裁定后纳入）。"}}
{"case_id": "LV-FY2027Q1-INV-DIO-001", "event_family_id": "LV-FY2027Q1-working-capital", "question_origin": "analyst_constructed", "company": "Lenovo", "fiscal_year": 2027, "fiscal_quarter": 1, "period_end": "2026-06-30", "publication_date": "2026-08-13", "query": "联想 FY2027Q1 期末存货同比大增约 80%。这是否意味着周转'恶化了 80%'？请按口径 (期初存货+期末存货)/2 ÷ 单季营业成本 × 当季天数 计算本期与上年同期的 DIO 并给出变化天数；再说明高增长与 DIO 变化各自支持什么结论、不支持什么结论。", "sources": [{"pdf": "FY27Q1_130820261201.pdf", "url": "https://www1.hkexnews.hk/listedco/listconews/sehk/2026/0813/2026081300142_c.pdf", "sha256": "337d22412402e35a7d4c1ca2b01e19e30ec409ad503b148765e55ee1c4d0f0ec", "pdf_pages": [3, 14, 24], "printed_pages": [3, 14, 24], "section": "综合资产负债表；存货附注"}], "management_reference": {"paraphrase": "管理层 p3 称零部件供需失衡可能在短期内带来阻力与市场波动，p4 展望重申该挑战；未在公告中给出为应对涨价主动备货的明确表述。", "evidence_spans": [{"pdf_page": 3, "quote": "儘管零部件供需失衡可能繼續在短期內帶來阻力及市場波動"}]}, "required_inputs": [{"metric": "inventory", "entity": "Lenovo 集团", "period": "时点 FY2025Q4/FY2026Q1/FY2026Q4/FY2027Q1", "raw_value": "7,923,804 / 8,742,635 / 11,720,885 / 15,741,947 千美元", "raw_unit": "usd_kn", "unified_value": 15741.947, "unified_unit": "usd_mn", "scope": "时点", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [14]}, "db": {"location": "facts.account_code='inventory'", "value": 15741.947, "status": "match"}}, {"metric": "cogs", "entity": "Lenovo 集团", "period": "单季 FY2026Q1 / FY2027Q1", "raw_value": "16,055,392 / 22,490,797 千美元", "raw_unit": "usd_kn", "unified_value": 22490.797, "unified_unit": "usd_mn", "scope": "单季", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [5]}, "db": {"location": "facts.account_code='cogs'", "value": 22490.797, "status": "match"}}, {"metric": "quarter_days", "entity": "计算口径", "period": "Apr–Jun 2026（上年同期 Apr–Jun 2025）", "raw_value": "91", "raw_unit": "天", "unified_value": 91, "unified_unit": "天", "scope": "单季", "version": "original", "source": {"pdf": null, "pdf_pages": []}, "db": {"location": null, "status": "assumption_declared"}}], "calculations": [{"id": "dio_prior", "formula": "(7923.804+8742.635)/2 ÷ 16055.392 × 91", "result": 47.2317, "unit": "天", "tolerance_abs": 0.05, "tolerance_basis": "输入为精确值，容差覆盖天数口径±1天的解释差；换 92 天时结果应整体重算并声明"}, {"id": "dio_curr", "formula": "(11720.885+15741.947)/2 ÷ 22490.797 × 91", "result": 55.5587, "unit": "天", "tolerance_abs": 0.05, "tolerance_basis": "同上"}, {"id": "dio_delta", "result": 8.327, "unit": "天", "tolerance_abs": 0.06, "tolerance_basis": "两端舍入累积", "formula": "dio_curr − dio_prior = 55.5587 − 47.2317"}, {"id": "inv_yoy", "formula": "15741.947/8742.635-1", "result": 0.8006, "unit": "比例", "tolerance_abs": 0.002, "tolerance_basis": "精确输入直算"}, {"id": "cogs_yoy", "formula": "22490.797/16055.392-1", "result": 0.4008, "unit": "比例", "tolerance_abs": 0.002, "tolerance_basis": "同上"}], "scorable_answer": {"must_include": ["DIO 由 47.23 天升至 55.56 天（约 +8.33 天，相对 +17.6%），周转确有放缓但远小于'80%'的直觉", "存货 +80.1% 而营业成本 +40.1%：余额增速约为流量增速两倍，分母（平均存货基数变大）解释了为什么余额大增而 DIO 只升 17.6%", "两个指标口径不同（时点余额 vs 平均余额/单季流量），不能互相替代", "备货 vs 滞销 vs 成本上升，仅凭 DIO/存货增速不可区分；管理层的零部件供需失衡只是待验证假设"], "acceptable_variants": ["用 90 或 92 天口径重算并声明，DIO 水平变化约 ±0.5 天但同比差方向结论不变", "用存货/COGS 期末口径替代平均口径，需声明且不得与本题 47.23/55.56 混用"], "must_not_claim": ["不得说周转恶化 80% 或周转恶化速度=存货增速", "不得断定'主动为涨价备货'或'产品滞销'——存货构成（原材料/在制品占 63%，p24）与拨备变化支持哪一侧需真实附注数据，当前 DB 无", "不得用收入替代营业成本计算 DIO"], "unknowns": ["存货构成中原材料/在制品 9,961.6 百万与制成品 5,203.9 百万（p24，千美元口径 9,961,612/5,203,905）未在 DB，无法量化判断采购备货 vs 成品积压"]}, "db_support": {"status": "ready", "checked_at": "2026-10-05", "missing_fields": [], "notes": "DIO 全部输入可由 DB 原值直算；构成分析属 unknowns 记录缺口，不影响可评分部分。"}}
{"case_id": "LV-FY2027Q1-WC-CCC-001", "event_family_id": "LV-FY2027Q1-working-capital", "question_origin": "analyst_constructed", "company": "Lenovo", "fiscal_year": 2027, "fiscal_quarter": 1, "period_end": "2026-06-30", "publication_date": "2026-08-13", "query": "FY2027Q1 联想存货、应收、应付同季齐涨约 70%–80%。备货是否挤压了联想的现金？请按同比 DSO/DIO/DPO 与现金转换周期 CCC（均用当季天数 91、流量用单季收入/营业成本）判断这轮营运资金扩张主要由谁出资，并用现金余额检验结论；说明现金流量表口径下还缺什么。", "sources": [{"pdf": "FY27Q1_130820261201.pdf", "url": "https://www1.hkexnews.hk/listedco/listconews/sehk/2026/0813/2026081300142_c.pdf", "sha256": "337d22412402e35a7d4c1ca2b01e19e30ec409ad503b148765e55ee1c4d0f0ec", "pdf_pages": [3, 14, 15], "printed_pages": [3, 14, 15], "section": "综合资产负债表及其续"}], "management_reference": {"paraphrase": "管理层 p3 称凭借行业领先的供应链应对零部件供需失衡；p2 称 AI 服务器项目储备环比增至 540 亿美元。均未直接披露备货的现金安排。", "evidence_spans": [{"pdf_page": 3, "quote": "行業領先的供應鏈，應對運營環境帶來的挑戰"}]}, "required_inputs": [{"metric": "accounts_payable", "entity": "Lenovo 集团", "period": "时点 FY2025Q4/FY2026Q1/FY2026Q4/FY2027Q1", "raw_value": "11,978,933 / 14,187,753 / 19,236,706 / 24,397,551 千美元", "raw_unit": "usd_kn", "unified_value": 24397.551, "unified_unit": "usd_mn", "scope": "时点", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [15]}, "db": {"location": "facts.account_code='accounts_payable'", "value": 24397.551, "status": "match"}}, {"metric": "accounts_receivable", "entity": "Lenovo 集团", "period": "时点 FY2025Q4/FY2026Q1/FY2026Q4/FY2027Q1", "raw_value": "10,506,610 / 10,796,573 / 14,502,738 / 19,265,786 千美元", "raw_unit": "usd_kn", "unified_value": 19265.786, "unified_unit": "usd_mn", "scope": "时点", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [14]}, "db": {"location": "facts.account_code='accounts_receivable'", "value": 19265.786, "status": "match"}}, {"metric": "cash", "entity": "Lenovo 集团", "period": "时点 FY2026Q1 / FY2027Q1", "raw_value": "4,504,440 / 5,907,477 千美元", "raw_unit": "usd_kn", "unified_value": 5907.477, "unified_unit": "usd_mn", "scope": "时点", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [14]}, "db": {"location": "facts.account_code='cash'", "value": 5907.477, "status": "match"}}, {"metric": "inventory", "entity": "Lenovo 集团", "period": "同 LV-FY2027Q1-INV-DIO-001", "raw_unit": "usd_kn", "unified_unit": "usd_mn", "scope": "时点", "version": "original", "source": {"pdf": "FY27Q1_130820261201.pdf", "pdf_pages": [14]}, "db": {"location": "facts", "status": "match"}}, {"metric": "cogs", "entity": "Lenovo 集团", "period": "单季 FY2026Q1 / FY2027Q1", "raw_unit": "usd_kn", "unified_unit": "usd_mn", "scope": "单季", "version": "original", "db": {"location": "facts", "status": "match"}}, {"metric": "revenue", "entity": "Lenovo 集团", "period": "单季 FY2026Q1 / FY2027Q1", "raw_unit": "usd_kn", "unified_unit": "usd_mn", "scope": "单季", "version": "original", "db": {"location": "facts", "status": "match"}}], "calculations": [{"id": "dso", "formula": "DSO=平均应收/单季收入×91：上年同期 51.4765 → 本期 57.0271", "result": 57.0271, "unit": "天", "tolerance_abs": 0.05, "tolerance_basis": "同 INV-DIO 口径说明"}, {"id": "dpo", "formula": "DPO=平均应付/单季COGS×91：74.1548 → 88.2743", "result": 88.2743, "unit": "天", "tolerance_abs": 0.05, "tolerance_basis": "同上"}, {"id": "ccc", "formula": "CCC=DSO+DIO-DPO：24.5533 → 24.3115", "result": 24.3115, "unit": "天", "tolerance_abs": 0.07, "tolerance_basis": "三项舍入累积"}, {"id": "wc_funding", "formula": "Δ存货+Δ应收-Δ应付 = 7020.312+8470.213-10209.798 = +5280.727（同比净增）", "result": 5280.727, "unit": "usd_mn", "tolerance_abs": 0.01, "tolerance_basis": "精确输入直算"}, {"id": "ap_vs_inv", "formula": "应付同比增量 10209.798 与存货增量 7020.312 之比 = 1.454", "result": 1.454, "unit": "倍", "tolerance_abs": 0.005, "tolerance_basis": "直算"}], "scorable_answer": {"must_include": ["DPO +14.12 天的拉长幅度大于 DSO +5.55 与 DIO +8.33 之和的超出部分，CCC 同比基本持平（24.55→24.31 天）", "应付同比增量（+102.1 亿）大于存货增量（+70.2 亿），本轮营运资金净占用仅 +52.8 亿且由上游账期承担了近一半以上扩张额", "现金余额同比 +31.2%（45.0→59.1 亿）与'备货挤压现金'的直觉相反", "必须声明：由应付/应收/存货推断'上游供应链出资'是与数字一致的解释，不等于已证实的账期协议变化；精确的经营现金流需要现金流量表（DB 无）"], "acceptable_variants": ["用期末余额直比代替平均口径的近似检验，需声明口径", "把净占用按'存货+应收-应付'或'营运资金总额'不同定义计算，允许只要一致"], "must_not_claim": ["不得给出经营现金流或自由现金流的具体数值（无现金流量表数据）", "不得断言对供应商账期'谈判力增强'为已证实事实", "不得把应付大增直接解读为拖欠风险——付款条件与账龄结构不在数据内"], "unknowns": ["账期政策变化、保理安排规模（p7 提到保理成本增加 1,200 万美元但未入数据层）、区域备货结构"]}, "db_support": {"status": "ready", "checked_at": "2026-10-05", "missing_fields": [], "notes": "全部输入 DB 可查且与 PDF 一致；现金流量表科目未建模，属本题 unknowns 声明的一部分。"}}
